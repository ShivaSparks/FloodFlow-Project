# FloodFlow Environment Configuration Template
# Copy this file to .env for local use: cp .env.example .env
# Never commit your real .env file.

APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database configuration
# Local SQLite fallback: sqlite:///./floodflow_stage2.sqlite3
# Remote PostgreSQL / Neon / PostGIS:
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Data paths
DATA_ROOT=./data/flood_project_data
PROCESSED_DATA_ROOT=./data/processed

# Chennai Pilot Bounding Box (Velachery / Pallikaranai / Medavakkam)
PILOT_SOUTH=12.90
PILOT_NORTH=13.00
PILOT_WEST=80.18
PILOT_EAST=80.245

# Coordinate Reference System
SOURCE_CRS=EPSG:4326
TARGET_CRS=EPSG:4326

# Data validation flags
FAIL_ON_INVALID_GEOMETRY=false
FAIL_ON_MISSING_METADATA=false

# Demo / Prototype Administrator Seed Account (scripts/create_demo_operator.py)
DEMO_OPERATOR_EMAIL=operator@example.com
DEMO_OPERATOR_PASSWORD=change-me-to-a-secure-password
